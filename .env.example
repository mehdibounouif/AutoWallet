# Database Configuration
POSTGRES_USER=autowallet
POSTGRES_PASSWORD=autowallet
POSTGRES_DB=autowallet
DATABASE_URL=postgresql://autowallet:autowallet@postgres:5432/autowallet

# Security & Secrets
SECRET_KEY=supersecretkeyforautowalletdevenvironment123456
REDIS_URL=redis://redis:6379/0
POLL_INTERVAL_SECONDS=60
BANK_SIMULATOR_URL=http://bank-simulator:8001

# OAuth & Frontend URLs
GOOGLE_CLIENT_ID=dev-google-client-id
GOOGLE_CLIENT_SECRET=dev-google-client-secret
GOOGLE_REDIRECT_URI=https://localhost/api/auth/oauth/google/callback
FRONTEND_GOOGLE_CALLBACK_URL=https://localhost/auth/google/callback
FRONTEND_ORIGIN=https://localhost
FRONTEND_EMAIL_VERIFY_URL=https://localhost/auth/verify-email

# Mailpit (Dev SMTP)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=AutoWallet <no-reply@autowallet.local>

# AI Assistant
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.5-flash-lite
AI_RATE_LIMIT_PER_MINUTE=20
