# REQUIRED for docker compose — copy to .env (same folder) and adjust.
# Compose refuses to boot with defaults baked out: every value below must
# exist in your .env, or the stack fails loudly at startup.
# Never commit the real .env.
SECRET_KEY=dev-secret-change-me-later

POSTGRES_USER=autowallet
POSTGRES_PASSWORD=autowallet
POSTGRES_DB=autowallet

# Bank-simulator polling interval in seconds (backend poller tick)
POLL_INTERVAL_SECONDS=60

# Google OAuth (the backend requires these to boot — finding #9).
# Placeholder values keep the stack booting with OAuth effectively
# disabled; real login needs real credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=not-configured
GOOGLE_CLIENT_SECRET=not-configured
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/oauth/google/callback
