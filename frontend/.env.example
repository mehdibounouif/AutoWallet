# Vite's server-side proxy. The default matches the root Docker Compose stack.
API_PROXY_TARGET=https://localhost

# If Caddy's local CA is not already trusted by Node, copy its PUBLIC root
# certificate as described in DEVELOPMENT.md, then uncomment this setting.
# API_PROXY_CA_FILE=.certs/caddy-root.crt

# For a backend running directly on your host instead of Compose:
# API_PROXY_TARGET=http://127.0.0.1:8000
