DATABASE_URL=sqlite:///./flowpay.db
SECRET_KEY=dev-secret-change-me-later
REDIS_URL=redis://localhost:6379/0
BANK_SIMULATOR_URL=http://127.0.0.1:8001
GOOGLE_CLIENT_ID=your-client-id-here
GOOGLE_CLIENT_SECRET=your-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/oauth/google/callback

# AI assistant (app/ai): any OpenAI-compatible API, Google Gemini by default.
# Without AI_API_KEY the assistant answers 503 "not configured"; the rest of the app works.
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.5-flash-lite
