DATABASE_URL=sqlite:///./flowpay.db
SECRET_KEY=dev-secret-change-me-later
REDIS_URL=redis://localhost:6379/0
BANK_SIMULATOR_URL=http://127.0.0.1:8001
# Emails for the GDPR pages (app/gdpr): account deletion codes and export notices.
# In development, Mailpit catches them: its inbox is on http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=AutoWallet <no-reply@autowallet.local>
GOOGLE_CLIENT_ID=your-client-id-here
GOOGLE_CLIENT_SECRET=your-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/oauth/google/callback