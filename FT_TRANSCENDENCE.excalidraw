      "updated": 1787654826459,
      "link": null,
      "locked": false,
      "text": "Encryption is designed\nso that data can be recovered.",
      "fontSize": 33.051488189785935,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Encryption is designed\nso that data can be recovered.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "WP4ixDt79WZRoY5TxSECT",
      "type": "text",
      "x": -920.3350939499526,
      "y": -1079.4256849362046,
      "width": 545.2747802734375,
      "height": 41.31436023723242,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
