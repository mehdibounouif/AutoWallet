      "isDeleted": true,
      "boundElements": [
        {
          "id": "33Owp4pbt6K5W0Es3yCfp",
          "type": "arrow"
        }
      ],
      "updated": 1787654826458,
      "link": null,
      "locked": false,
      "text": "delete \"sqlalchemy.url = driver://user:pass@localhost/dbname\"",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "delete \"sqlalchemy.url = driver://user:pass@localhost/dbname\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "nVsXiqWZejldwK_-lgBsL",
      "type": "text",
      "x": 2426.2616274570983,
      "y": 1174.7749764796747,
      "width": 802.9990234375,
      "height": 250,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "2iNjB79YPToe6tssFB__-"
      ],
      "frameId": null,
      "index": "b0K",
      "roundness": null,
      "seed": 1432859991,
      "version": 505,
      "versionNonce": 2112537281,
      "isDeleted": true,
      "boundElements": [
        {
          "id": "f_iQwehT7niK1_UsAb5OU",
          "type": "arrow"
        }
      ],
      "updated": 1787654826458,
      "link": null,
      "locked": false,
      "text": "import sys\nimport os\n\nsys.path.append(os.path.join(os.path.dirname(__file__), \"..\"))\n\nfrom app.core.database import Base\nfrom app.core.config import settings\nfrom app.models import models  # noqa: F401 (import registers the tables)\n\ntarget_metadata = Base.metadata",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "import sys\nimport os\n\nsys.path.append(os.path.join(os.path.dirname(__file__), \"..\"))\n\nfrom app.core.database import Base\nfrom app.core.config import settings\nfrom app.models import models  # noqa: F401 (import registers the tables)\n\ntarget_metadata = Base.metadata",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "JnS54DyOdRDHbMinkAS0a",
      "type": "text",
      "x": 1818.9289006486365,
      "y": 1015.115575992266,
      "width": 406.99951171875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "2iNjB79YPToe6tssFB__-"
      ],
      "frameId": null,
      "index": "b0L",
      "roundness": null,
      "seed": 495256119,
      "version": 427,
      "versionNonce": 1020589039,
      "isDeleted": true,
      "boundElements": [
        {
          "id": "f_iQwehT7niK1_UsAb5OU",
          "type": "arrow"
        }
      ],
      "updated": 1787654826458,
      "link": null,
      "locked": false,
      "text": "Replace \"target_metadata = None\" with",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Replace \"target_metadata = None\" with",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "QigBS-qIqwlgV2fws3z7P",
      "type": "text",
      "x": 1689.6256072178771,
      "y": 1156.142611129927,
      "width": 692.9990234375,
      "height": 125,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "2iNjB79YPToe6tssFB__-"
      ],
      "frameId": null,
      "index": "b0M",
      "roundness": null,
      "seed": 1346719447,
      "version": 573,
      "versionNonce": 1578616449,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787654826458,
      "link": null,
      "locked": false,
      "text": "Then replace:\nconfig.set_main_option(\"sqlalchemy.url\")\n\nWith:\nconfig.set_main_option(\"sqlalchemy.url\", settings.database_url)",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Then replace:\nconfig.set_main_option(\"sqlalchemy.url\")\n\nWith:\nconfig.set_main_option(\"sqlalchemy.url\", settings.database_url)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "RGm7UeLIAMvuigWfhUkn-",
      "type": "text",
      "x": 1917.762278583862,
      "y": 1524.6488889400885,
      "width": 769.9989624023438,
      "height": 75,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "2iNjB79YPToe6tssFB__-"
      ],
      "frameId": null,
      "index": "b0N",
      "roundness": null,
      "seed": 1322333687,
      "version": 689,
      "versionNonce": 84844047,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787654826458,
      "link": null,
      "locked": false,
      "text": "\"Look at my SQLAlchemy models, compare them with the current database,\nand generate a new Alembic migration file describing the differences.\nGive that migration the message create initial tables.\"",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"Look at my SQLAlchemy models, compare them with the current database,\nand generate a new Alembic migration file describing the differences.\nGive that migration the message create initial tables.\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "9PydB4fIa4JmiwTuml4SS",
      "type": "text",
      "x": 1725.3464986992308,
      "y": 1742.940936189998,
      "width": 791.9989624023438,
      "height": 50,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "2iNjB79YPToe6tssFB__-"
      ],
      "frameId": null,
      "index": "b0O",
      "roundness": null,
      "seed": 1784320409,
      "version": 769,
      "versionNonce": 255676001,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787654826458,
      "link": null,
      "locked": false,
      "text": "\"Take my database from its current migration version\nand apply all pending migrations until it reaches the latest migration.\"",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"Take my database from its current migration version\nand apply all pending migrations until it reaches the latest migration.\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "AsJwBfNgtGVfvRRWNIbFR",
      "type": "text",
      "x": 1169.1092213669817,
      "y": 636.1710333582013,
      "width": 670.9990234375,
      "height": 1025,
      "angle": 0,
      "strokeColor": "#0c8599",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "2iNjB79YPToe6tssFB__-"
      ],
      "frameId": null,
      "index": "b0P",
      "roundness": null,
      "seed": 686920697,
      "version": 497,
      "versionNonce": 1207674447,
      "isDeleted": true,
      "boundElements": [
        {
          "id": "4D5PXQS6Faj2Cc67aI293",
          "type": "arrow"
        }
      ],
      "updated": 1787654826458,
      "link": null,
      "locked": false,
      "text": "1- cd backend\n\n2- rm -rf alembic\n\n3- alembic init alembic\n\n4- Edit 1 - alembic.ini\n\n5- Edit 2 — alembic/env.py\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n6- Verify it worked \"alembic current\"\n\n7- alembic revision --autogenerate -m \"create initial tables\"\n\n\n\n\n\n\n\n\n\n\n8- alembic upgrade head",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1- cd backend\n\n2- rm -rf alembic\n\n3- alembic init alembic\n\n4- Edit 1 - alembic.ini\n\n5- Edit 2 — alembic/env.py\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n6- Verify it worked \"alembic current\"\n\n7- alembic revision --autogenerate -m \"create initial tables\"\n\n\n\n\n\n\n\n\n\n\n8- alembic upgrade head",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "H86HL84ki9BESGfG1dWVs",
