      "type": "text",
      "x": -2274.3835556613985,
      "y": -919.159086252331,
      "width": 1017.846435546875,
      "height": 206.5718011861621,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2hMb",
