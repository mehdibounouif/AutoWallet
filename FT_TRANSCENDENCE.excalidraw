      "updated": 1787654826459,
      "link": null,
      "locked": false,
      "text": "This is a database session. \nThink of it as a “scratchpad” where you prepare changes to your database. \nYou add, delete, or update records in the session,\n and then you “commit” them to save permanently.",
      "fontSize": 50.74771664414552,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This is a database session. \nThink of it as a “scratchpad” where you prepare changes to your database. \nYou add, delete, or update records in the session,\n and then you “commit” them to save permanently.",
      "autoResize": true,
      "lineHeight": 1.25
    },
