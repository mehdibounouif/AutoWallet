      "seed": 1280492473,
      "version": 208,
      "versionNonce": 1890179873,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787654826458,
      "link": null,
      "locked": false,
      "text": "\"Run Alembic, initialize a migration environment,\nand put it inside a directory called alembic.\"",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"Run Alembic, initialize a migration environment,\nand put it inside a directory called alembic.\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Rth4WBxXoiKztnm1e2GZV",
      "type": "text",
      "x": 1840.714474064379,
      "y": 965.816740121033,
      "width": 670.9990844726562,
      "height": 25,
      "angle": 0,
      "strokeColor": "#c2255c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "2iNjB79YPToe6tssFB__-"
      ],
      "frameId": null,
      "index": "b0J",
      "roundness": null,
      "seed": 1235295321,
      "version": 321,
