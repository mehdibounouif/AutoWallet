      "isDeleted": true,
      "boundElements": [],
      "updated": 1787654826459,
      "link": null,
      "locked": false,
      "text": "You can go in both directions.",
      "fontSize": 33.051488189785935,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "You can go in both directions.",
