      "text": "\"password123\"\n   |\n                              | encryption algorithm + key\n   v\n             \"X7$kP92...\" ciphertext. ",
      "fontSize": 33.051488189785935,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"password123\"\n   |\n                              | encryption algorithm + key\n   v\n             \"X7$kP92...\" ciphertext. ",
