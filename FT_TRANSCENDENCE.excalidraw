      "isDeleted": true,
      "boundElements": [],
      "updated": 1787654826458,
      "link": null,
      "locked": false,
      "text": "                    LOGIN\n                      |\n                      v\n                     email + password\n                      |\n                      v\n                      Find user by email\n                      |\n                      v\n                       Get that user's\n                     password hash\n                      |\n                      v\n                    Get salt/parameters from stored hash\n                      |\n                      v\n                 hashing the entered password\n                  using the stored salt\n                      |\n                      v\n                     compare hashed passwords\n                      |\n                      +-------+-------+\n                      |               |\n                        MATCH           NO MATCH\n                      |               |\n                      v               v\n                      logged in        rejected",
      "fontSize": 32.29907069343391,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "                    LOGIN\n                      |\n                      v\n                     email + password\n                      |\n                      v\n                      Find user by email\n                      |\n                      v\n                       Get that user's\n                     password hash\n                      |\n                      v\n                    Get salt/parameters from stored hash\n                      |\n                      v\n                 hashing the entered password\n                  using the stored salt\n                      |\n                      v\n                     compare hashed passwords\n                      |\n                      +-------+-------+\n                      |               |\n                        MATCH           NO MATCH\n                      |               |\n                      v               v\n                      logged in        rejected",
      "autoResize": true,
      "lineHeight": 1.25
    },
