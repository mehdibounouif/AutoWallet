    {
      "id": "To-qAfLt3ZwK5tYftnc8N",
      "type": "text",
      "x": -3515.046872360931,
      "y": -1370.4855253466012,
      "width": 902.451904296875,
      "height": 1557.744941213844,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
